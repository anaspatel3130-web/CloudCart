# CloudCart local / deploy parameters (not secrets).
# Copy values into backend/.env for seed scripts, or pass them as SAM parameter overrides.
# Never put AWS access keys in this file. Use `aws configure` or a named profile.

AWS_REGION=ap-south-1
AWS_PROFILE=cloudcart
STACK_NAME=cloudcart

# DynamoDB table names (must match TableNamePrefix in backend/template.yaml)
PRODUCTS_TABLE=CloudCart-Products
CARTS_TABLE=CloudCart-Carts
ORDERS_TABLE=CloudCart-Orders
AUTOMATION_STATE_TABLE=CloudCart-AutomationState

# Frontend CORS origin. After CloudFront deploy, change this to https://dxxxx.cloudfront.net
ALLOWED_ORIGIN=http://localhost:8080

# Frontend runtime (edit frontend/js/config.js after you have an API URL)
# CLOUDCART_API_BASE_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com/Prod

AUTH_MODE=demo
STAGE=dev
DEFAULT_DEMO_USER_ID=demo-user

# Inventory monitor
LOW_STOCK_THRESHOLD=5
INVENTORY_MONITOR_SCHEDULE=rate(1 day)

# Leave empty unless you intentionally enable SNS in a deploy you approved
ALERT_TOPIC_ARN=
