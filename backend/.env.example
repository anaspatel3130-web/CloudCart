# Copy to .env for local scripts only. Lambda receives these from the SAM template.
# Never commit real credentials, a production DemoAdminKey, or AWS access keys.

AWS_REGION=ap-south-1
AWS_PROFILE=cloudcart

PRODUCTS_TABLE=CloudCart-Products
CARTS_TABLE=CloudCart-Carts
ORDERS_TABLE=CloudCart-Orders
AUTOMATION_STATE_TABLE=CloudCart-AutomationState

# demo = X-CloudCart-User-Id header (and default demo-user)
# jwt  = require a Cognito/JWT authorizer claim
AUTH_MODE=demo
STAGE=dev
DEFAULT_DEMO_USER_ID=demo-user

# Browser origin allowed by CORS. Use the CloudFront URL after frontend hosting is enabled.
ALLOWED_ORIGIN=http://localhost:8080

# Development-only admin header (X-CloudCart-Admin-Key). Leave empty in production.
DEMO_ADMIN_KEY=

# Inventory monitor (set on the Lambda by SAM; listed here for local invoke docs)
LOW_STOCK_THRESHOLD=5
ALERT_TOPIC_ARN=

# Seed script only. Do not point this at a shared production table by accident.
# SEED_CONFIRM=yes
